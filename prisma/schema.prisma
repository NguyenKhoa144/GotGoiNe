datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  dateOfBirth  DateTime
  passwordHash String
  phone        String   @unique
  email        String   @unique
  role         String   @default("user")
  createdAt    DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  category    String
  emoji       String
  name        String
  weight      String
  price       String
  badge       String?
  featured    Boolean  @default(false)
  description String?
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Ảnh thật thay cho emoji — thêm sẵn cột để sau này bật upload không phải
  // migrate lại; hiện chưa dùng, giao diện vẫn hiển thị emoji.
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuEntries DailyMenuEntry[]
  losses      InventoryLoss[]
}

// Một dòng = một loại trái cây trong thực đơn của MỘT ngày. Không ghi đè qua
// ngày mới: mỗi ngày là một bộ dòng riêng, nhờ vậy giữ được lịch sử bán/hao
// hụt để tính thống kê về sau.
model DailyMenuEntry {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Ngày áp dụng, tính theo lịch Việt Nam (lưu ở UTC midnight của ngày đó).
  date         DateTime @db.Date
  // Giá bán của riêng ngày hôm đó, đơn vị đồng (số nguyên, không phải chuỗi
  // "45.000₫" như Product.price) để cộng ra doanh thu được.
  priceToday   Int
  qtyGrams     Int
  soldGrams    Int      @default(0)
  spoiledGrams Int      @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Chốt ngày chạy lại nhiều lần cũng chỉ ghi đè đúng một dòng, không nhân đôi.
  @@unique([productId, date])
}

model InventoryLoss {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  amountGrams Int
  reason      String
  note        String?
  createdAt   DateTime @default(now())
}
