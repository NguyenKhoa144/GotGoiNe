datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  dateOfBirth  DateTime
  passwordHash String
  phone        String   @unique
  email        String   @unique
  role         String   @default("user")
  createdAt    DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  category    String
  emoji       String
  name        String
  weight      String
  price       String
  badge       String?
  featured    Boolean  @default(false)
  description String?
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Ảnh thật thay cho emoji — thêm sẵn cột để sau này bật upload không phải
  // migrate lại; hiện chưa dùng, giao diện vẫn hiển thị emoji.
  imageUrl    String?
  // Tồn kho tủ lạnh, tính bằng gram. Đây là NGUỒN SỰ THẬT duy nhất về việc
  // quán còn bao nhiêu của loại này — chạy dài qua ngày, không reset theo
  // ngày như DailyMenuEntry.qtyGrams trước đây. Mọi thay đổi phải đi kèm một
  // dòng StockMovement giải thích vì sao, không bao giờ sửa trần.
  stockGrams  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuEntries DailyMenuEntry[]
  losses      InventoryLoss[]
  movements   StockMovement[]
}

// Một dòng = một loại trái cây trong thực đơn của MỘT ngày. Không ghi đè qua
// ngày mới: mỗi ngày là một bộ dòng riêng, nhờ vậy giữ được lịch sử bán/hao
// hụt để tính thống kê về sau.
model DailyMenuEntry {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Ngày áp dụng, tính theo lịch Việt Nam (lưu ở UTC midnight của ngày đó).
  date         DateTime @db.Date
  // Giá bán của riêng ngày hôm đó, đơn vị đồng (số nguyên, không phải chuỗi
  // "45.000₫" như Product.price) để cộng ra doanh thu được.
  priceToday   Int
  qtyGrams     Int
  soldGrams    Int      @default(0)
  spoiledGrams Int      @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Chốt ngày chạy lại nhiều lần cũng chỉ ghi đè đúng một dòng, không nhân đôi.
  @@unique([productId, date])
}

model InventoryLoss {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  amountGrams Int
  reason      String
  note        String?
  createdAt   DateTime @default(now())
}

// Nhật ký mọi biến động của tủ lạnh: nhập hàng, bán ra, hao hụt. Một dòng =
// một lần kho thay đổi, và Product.stockGrams luôn bằng tổng đại số của các
// dòng này. Nhờ vậy con số tồn kho luôn giải thích được — sai ở đâu thì dò
// lại được tới đúng thao tác gây ra.
model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Ngày áp dụng theo lịch Việt Nam (00:00 UTC của ngày đó), để gom nhóm
  // thống kê theo ngày mà không lệch múi giờ.
  date        DateTime @db.Date
  // IMPORT: nhập thêm hàng vào tủ (cộng kho).
  // SALE:    bán ra cho khách (trừ kho).
  // LOSS:    mất vì lý do khác — Thảo ăn, hư/dập... (trừ kho).
  // ADJUST:  admin sửa tay cho khớp thực tế (cộng hoặc trừ).
  kind        String
  // Luôn là số DƯƠNG. Hướng cộng/trừ do `kind` quyết định, không nhét dấu âm
  // vào đây — nếu không, mọi phép cộng thống kê đều phải nhớ quy ước riêng.
  amountGrams Int
  // Chênh lệch thực tế đã áp vào kho (dương = cộng, âm = trừ). Ghi sẵn để
  // cộng dồn ra tồn kho mà không phải suy diễn lại từ `kind`.
  deltaGrams  Int
  // Với LOSS là lý do bắt buộc; với ADJUST là ghi chú tuỳ ý.
  reason      String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([productId, date])
  @@index([date])
}
